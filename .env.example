# Copy to .env.local for `neon dev` / local tests (`neon env pull --file .env.local`).
# Copy to .env.prod for Function apply. Each checkout owns its own copies. Never symlink.
#
#   SENTRY_RELEASE=$(git rev-parse --short HEAD) neon deploy --profile dbx --env .env.prod
# SENTRY_RELEASE is the apply SHA. Do not store it in .env.prod.

# Required. AES-256-GCM key material for refresh tokens at rest.
APP_SECRET=

# Public URL of this Function, no trailing slash.
# .env.local: http://127.0.0.1:8787
# .env.prod: https://br-delicate-grass-axxm1jia-originneon.compute.c-4.us-east-2.aws.neon.tech
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Labs path: project-scoped Neon API key + the project that receives PR branches.
# Not a user-scoped key. Not written into any customer git repo.
NEON_API_KEY=
NEON_PROJECT_ID=

# Comma-separated Origin repository ids this process may touch.
# Empty means every webhook is rejected with action_required.
ORIGIN_REPO_ALLOWLIST=

# Origin app. Leave empty until the app exists at cursor.com/codebase/settings/apps.
ORIGIN_APP_ID=
ORIGIN_PRIVATE_KEY_PEM=
# Same as ORIGIN_APP_ID for this app.
ORIGIN_KEY_ID=

# Neon OAuth. The deployed Function rejects client_id=neonctl on a public HTTPS
# callback. Localhost + neonctl is the CLI-shaped path for local testing.
# .env.local: http://127.0.0.1:8787/oauth/neon/callback
# .env.prod: https://br-delicate-grass-axxm1jia-originneon.compute.c-4.us-east-2.aws.neon.tech/oauth/neon/callback
NEON_OAUTH_HOST=https://oauth2.neon.tech
NEON_OAUTH_CLIENT_ID=
NEON_OAUTH_REDIRECT_URI=

# Injected by Neon Functions. Set locally for `neon dev`.
# DATABASE_URL=

# Empty disables Sentry locally. Production SENTRY_DSN lives in .env.prod.
# Production SENTRY_RELEASE is set on the deploy command, not in .env.prod.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1
PRODUCTION_BRANCH=main

# Dedicated track.neon.tech write key. Empty disables emit. Required in .env.prod.
ANALYTICS_WRITE_KEY=
